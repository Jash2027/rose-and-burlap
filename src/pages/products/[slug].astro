---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const mailto = `mailto:hello@roseandburlap.com?subject=${encodeURIComponent(
  `Enquiry about ${product.name}`
)}`;
---

<BaseLayout title={`${product.name} — Rose & Burlap`}>
  <Header />

  <main class="max-w-6xl mx-auto px-6 py-12 md:py-20">

    <a href="/#collection" class="text-xs tracking-widest uppercase text-stone hover:text-sage transition">
      ← Back to collection
    </a>

    <div class="mt-8 grid md:grid-cols-2 gap-10 md:gap-16 items-start">

      <div class="aspect-[4/5] overflow-hidden bg-[#EDE7DE]">
        <img
          src={product.image}
          alt={product.name}
          class="w-full h-full object-cover"
        />
      </div>

      <div class="space-y-7">

        <div>
          <p class="text-xs tracking-[0.25em] uppercase text-sage mb-3">Handmade piece</p>
          <h1 class="font-serif text-4xl md:text-5xl leading-tight text-ink">{product.name}</h1>
          <p class="mt-3 text-sm text-stone">{product.tagline}</p>
        </div>

        <p class="text-base text-ink/80 leading-relaxed">{product.intro}</p>

        <div class="space-y-4 text-sm text-stone leading-relaxed">
          {product.description.map((para) => <p>{para}</p>)}
        </div>

        <div class="border-t border-stone/10 pt-6 space-y-4 text-sm">
          <div>
            <p class="text-xs tracking-widest uppercase text-sage mb-1">Details</p>
            <p class="text-stone">{product.details}</p>
          </div>
          <div>
            <p class="text-xs tracking-widest uppercase text-sage mb-1">Care</p>
            <p class="text-stone">{product.care}</p>
          </div>
        </div>

        <a
          href={mailto}
          class="inline-block text-xs tracking-widest uppercase text-sage border-b border-sage/40 pb-1 hover:border-sage transition"
        >
          Enquire about this piece →
        </a>

      </div>
    </div>

  </main>

  <Footer />
</BaseLayout>
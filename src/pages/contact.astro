---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact — Rose & Burlap">
  <Header />

  <main class="max-w-3xl mx-auto px-6 py-16 md:py-24">

    <p class="text-xs tracking-[0.25em] uppercase text-sage mb-4">Get in touch</p>
    <h1 class="font-serif text-4xl md:text-5xl leading-tight text-ink">
      We reply to every enquiry personally.
    </h1>
    <p class="mt-6 text-sm md:text-base text-stone leading-relaxed max-w-xl">
      Usually within 48 hours. Tell us which piece caught your eye, ask about a custom order,
      or just say hello.
    </p>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thank-you"
      class="mt-12 space-y-8"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>Don’t fill this out: <input name="bot-field" /></label>
      </p>

      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <label for="name" class="block text-xs tracking-widest uppercase text-sage mb-2">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full bg-transparent border-b border-stone/30 py-2 text-sm text-ink focus:outline-none focus:border-sage"
          />
        </div>
        <div>
          <label for="email" class="block text-xs tracking-widest uppercase text-sage mb-2">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full bg-transparent border-b border-stone/30 py-2 text-sm text-ink focus:outline-none focus:border-sage"
          />
        </div>
      </div>

      <div>
        <label for="piece" class="block text-xs tracking-widest uppercase text-sage mb-2">Which piece?</label>
        <select
          id="piece"
          name="piece"
          class="w-full bg-transparent border-b border-stone/30 py-2 text-sm text-ink focus:outline-none focus:border-sage"
        >
          <option value="">Not sure yet / general enquiry</option>
          <option>Product One</option>
          <option>Product Two</option>
          <option>Product Three</option>
          <option>Product Four</option>
          <option>Product Five</option>
          <option>Product Six</option>
          <option>Custom order</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-xs tracking-widest uppercase text-sage mb-2">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full bg-transparent border-b border-stone/30 py-2 text-sm text-ink focus:outline-none focus:border-sage resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="text-xs tracking-widest uppercase text-sage border-b border-sage/40 pb-1 hover:border-sage transition"
      >
        Send enquiry →
      </button>
    </form>

    <p class="mt-12 text-xs text-stone/70">
      或者直接发邮件到
      <a href="mailto:hello@roseandburlap.com" class="text-sage hover:text-ink transition">hello@roseandburlap.com</a>
    </p>

  </main>

  <Footer />
</BaseLayout>